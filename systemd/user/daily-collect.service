[Unit]
Description=Eastern flank daily source collect
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 60-minute connectivity wait plus per-source network retries. Do not kill mid-wait.
TimeoutStartSec=7200
WorkingDirectory=/home/supra/Projects/eastern-flank-monitor
ExecStart=/home/supra/Projects/eastern-flank-monitor/.venv/bin/python -u /home/supra/Projects/eastern-flank-monitor/scripts/m0/daily_collect.py
