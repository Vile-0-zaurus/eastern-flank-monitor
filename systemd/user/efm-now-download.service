[Unit]
Description=Eastern flank Now-download (disabled; window frozen in config/now.yaml)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# systemd does not expand a tilde. %h is the home directory.
# Override EFM_ROOT if the repo is not in ~/Projects/eastern-flank-monitor.
Environment=EFM_ROOT=%h/Projects/eastern-flank-monitor
ExecStart=/bin/sh -c 'cd "$EFM_ROOT" && exec "$EFM_ROOT/.venv/bin/python" -u "$EFM_ROOT/pipeline/fetch/now_download.py"'
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
